# VoicePrep API Environment Configuration

# Environment ("development" or "production")
ENVIRONMENT=production

# Database
# For Local Dev: sqlite+aiosqlite:///./voiceprep.db
# For Production (Neon / Supabase PostgreSQL):
# postgresql+asyncpg://<user>:<password>@<neon-hostname>/<dbname>?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./voiceprep.db

# JWT Authentication (Generate a strong 64-character secret in production)
JWT_SECRET=change_me_to_a_random_secure_secret_key_in_production_123456

# Storage ("local" for local disk, "supabase" for production cloud storage)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./uploads

# Supabase (Required if STORAGE_TYPE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=resumes

# Groq AI & STT API Key
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# CORS Allowed Origins (JSON array of frontend URLs)
CORS_ORIGINS=["https://your-voiceprep-app.vercel.app","http://localhost:5173"]
