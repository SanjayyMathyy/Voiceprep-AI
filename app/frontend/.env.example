# Frontend Environment Variables

# Backend API Base URL
# Local Dev: http://localhost:8000/api
# Production (Render): https://voiceprep-api.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# Optional: Dedicated WebSocket URL (if different from API URL)
# VITE_WS_URL=wss://voiceprep-api.onrender.com

# Supabase (Optional on frontend, handled by backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

